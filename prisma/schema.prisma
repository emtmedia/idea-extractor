generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id            String   @id @default(cuid())
  area          String
  interviewee   String?
  interviewDate String?
  answers       Json     @default("{}")
  canvas        Json     @default("{}")
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sessions")
}
